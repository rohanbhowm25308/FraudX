# --- LLM (optional; without it the agent uses a fact-based template instead of an LLM-written story) ---
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
AGENT_LLM_PLANNER=0        # 1 = let the LLM pick which tool to call next (still validated against real tools); 0 = deterministic state-driven planner

# --- TigerGraph (optional; without these the app runs on an in-memory graph with the same schema/shape) ---
TG_HOST=https://your-instance.i.tgcloud.io
TG_GRAPH=FraudX
TG_USER=tigergraph
TG_PASSWORD=
TG_SECRET=
TG_TOKEN=

# --- Dataset (optional; without it, synthetic demo data with the same shape is used) ---
DATA_DIR=./HHGOA_IEEE
